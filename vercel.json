{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "yarn install --frozen-lockfile --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/contributors",
      "destination": "/index.html"
    },
    {
      "source": "/contributors/apply",
      "destination": "/index.html"
    },
    {
      "source": "/api/gate/(.*)",
      "destination": "/api/gate?p=$1"
    },
    {
      "source": "/contribute",
      "destination": "/index.html"
    },
    {
      "source": "/research",
      "destination": "/index.html"
    },
    {
      "source": "/research/requests",
      "destination": "/index.html"
    },
    {
      "source": "/research/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/forum",
      "destination": "/index.html"
    },
    {
      "source": "/forum/:id",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/bnote",
      "destination": "/index.html"
    },
    {
      "source": "/bit",
      "destination": "/index.html"
    },
    {
      "source": "/structure",
      "destination": "/index.html"
    },
    {
      "source": "/membership",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/vision",
      "destination": "/index.html"
    },
    {
      "source": "/ethics",
      "destination": "/index.html"
    },
    {
      "source": "/mint",
      "destination": "/index.html"
    },
    {
      "source": "/mint-membership",
      "destination": "/index.html"
    },
    {
      "source": "/mint-bnote",
      "destination": "/index.html"
    },
    {
      "source": "/mint-bit",
      "destination": "/index.html"
    },
    {
      "source": "/mint-brgov",
      "destination": "/index.html"
    },
    {
      "source": "/members",
      "destination": "/index.html"
    },
    {
      "source": "/roadmap",
      "destination": "/index.html"
    },
    {
      "source": "/codeofethics",
      "destination": "/index.html"
    },
    {
      "source": "/visionstatement",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/contributors",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/contributors/apply",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/research/requests",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/contributor-artwork.js": {
      "includeFiles": "public/bittrees_logo_tree.png"
    }
  }
}
